# Secrets — never commit
.env

# Per-user brand config — each clone has its own
brand.config.json

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Build artefacts inside per-carousel folders.
# These are regenerated from manifest.json on every build, so they don't
# need to be tracked. Comment any of them out if you'd rather check
# rendered PNGs into git for review.
content-bank/almanac/almanac-*/*.html
content-bank/almanac/almanac-*/prompts.json
content-bank/almanac/almanac-*/captions.txt
content-bank/almanac/almanac-*/illustrations/
content-bank/almanac/almanac-*/out/
content-bank/almanac/almanac-*/previews/

# Generated theme — regenerated by build.py
content-bank/almanac/theme.css

# Render scratch
content-bank/almanac/.tmp/
